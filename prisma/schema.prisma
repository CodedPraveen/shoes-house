generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String            @id @default(cuid())
  name             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  clerkId          String            @unique
  deletedAt        DateTime?
  email            String            @unique
  role             String            @default("customer")
  addresses        Address[]
  cart             Cart?
  checkoutSessions CheckoutSession[]
  orders           Order[]
  reviews          Review[]
  wishlist         Wishlist[]

  @@index([email])
  @@index([role])
  @@index([deletedAt])
  @@index([createdAt])
}

model Category {
  id         String            @id @default(cuid())
  name       String
  slug       String            @unique
  imageUrl   String?
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  deletedAt  DateTime?
  collection ProductCollection
  parentId   String?
  parent     Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[]        @relation("CategoryTree")
  products   Product[]

  @@index([collection])
  @@index([slug])
  @@index([deletedAt])
  @@index([sortOrder])
}

model Product {
  id             String            @id @default(cuid())
  name           String
  brand          String            @default("Post Mart")
  slug           String            @unique
  description    String
  price          Int
  compareAtPrice Int?
  discount       Int?
  stock          Int               @default(0)
  isNew          Boolean           @default(false)
  isTrending     Boolean           @default(false)
  purchaseCount  Int               @default(0)
  rank           Int?
  materials      String?
  shippingInfo   String?
  returnPolicy   String?
  tags           String[]          @default([])
  categoryId     String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  collection     ProductCollection
  cartItems      CartItem[]
  orderItems     OrderItem[]
  category       Category          @relation(fields: [categoryId], references: [id])
  colors         ProductColor[]
  images         ProductImage[]
  sizes          ProductSize[]
  variants       ProductVariant[]
  reviews        Review[]
  wishlist       Wishlist[]

  @@index([slug])
  @@index([name])
  @@index([brand])
  @@index([categoryId])
  @@index([isNew])
  @@index([isTrending])
  @@index([purchaseCount])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([categoryId, deletedAt])
}

model ProductVariant {
  id                 String              @id @default(cuid())
  productId          String
  sku                String              @unique
  colorKey           String
  size               Int
  stock              Int                 @default(0)
  price              Int?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  cartItems          CartItem[]
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, colorKey, size])
  @@index([productId])
  @@index([sku])
  @@index([colorKey])
  @@index([stock])
  @@index([isActive])
  @@index([deletedAt])
  @@index([productId, deletedAt])
}

model ProductImage {
  id        String    @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int       @default(0)
  isHover   Boolean   @default(false)
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductColor {
  id        String  @id @default(cuid())
  productId String
  colorKey  String
  label     String
  hex       String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, colorKey])
}

model ProductSize {
  id        String  @id @default(cuid())
  productId String
  size      Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@index([userId])
  @@index([deletedAt])
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  color     String
  size      Int
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([cartId])
  @@index([productId])
  @@index([variantId])
  @@index([deletedAt])
  @@index([cartId, deletedAt])
}

model Wishlist {
  id        String    @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@index([deletedAt])
  @@index([userId, deletedAt])
}

model Address {
  id        String    @id @default(cuid())
  userId    String
  label     String    @default("Home")
  fullName  String
  phone     String
  line1     String
  landmark  String?
  line2     String?
  city      String
  state     String
  country   String    @default("India")
  pincode   String
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isDefault])
  @@index([deletedAt])
  @@index([userId, isDefault])
  @@index([pincode])
}

model CheckoutSession {
  id               String                @id @default(cuid())
  userId           String
  razorpayOrderId  String?               @unique
  subtotal         Int
  shippingCost     Int                   @default(0)
  total            Int
  currency         String                @default("INR")
  status           CheckoutSessionStatus @default(PENDING)
  shipAddressLabel String?
  shipFullName     String
  shipPhone        String
  shipLine1        String
  shipLandmark     String?
  shipLine2        String?
  shipCity         String
  shipState        String
  shipCountry      String                @default("India")
  shipPincode      String
  expiresAt        DateTime
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  orderId          String?               @unique
  mode             CheckoutSessionMode   @default(CART)
  order            Order?                @relation(fields: [orderId], references: [id])
  user             User                  @relation(fields: [userId], references: [id])
  items            CheckoutSessionItem[]

  @@index([userId])
  @@index([status])
  @@index([mode])
  @@index([razorpayOrderId])
  @@index([expiresAt])
  @@index([createdAt])
}

model CheckoutSessionItem {
  id              String          @id @default(cuid())
  sessionId       String
  productId       String
  variantId       String?
  productName     String
  productImage    String
  productSku      String
  color           String
  size            Int
  quantity        Int
  priceAtPurchase Int
  session         CheckoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Order {
  id                  String               @id @default(cuid())
  orderNumber         String               @unique
  userId              String
  status              OrderStatus          @default(PENDING)
  subtotal            Int
  shippingCost        Int                  @default(0)
  total               Int
  shipFullName        String
  shipPhone           String
  shipLine1           String
  shipLandmark        String?
  shipLine2           String?
  shipCity            String
  shipState           String
  shipCountry         String               @default("India")
  shipPincode         String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  refundReason        String?
  aftershipTrackingId String?
  deliveredAt         DateTime?
  lastTrackingSync    DateTime?
  shippedAt           DateTime?
  trackingNumber      String?
  trackingStatus      String?              @default("PENDING")
  trackingUrl         String?
  checkoutSession     CheckoutSession?
  inventoryMovements  InventoryMovement[]
  user                User                 @relation(fields: [userId], references: [id])
  items               OrderItem[]
  payments            Payment[]
  checkpoints         TrackingCheckpoint[]

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([userId, status])
  @@index([userId, createdAt])
}

model TrackingCheckpoint {
  id             String    @id @default(cuid())
  orderId        String
  checkpointTime DateTime?
  location       String?
  message        String
  tag            String?
  createdAt      DateTime  @default(now())
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([checkpointTime])
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  productId       String
  variantId       String?
  productName     String
  productImage    String
  productSku      String
  priceAtPurchase Int
  color           String
  size            Int
  quantity        Int
  createdAt       DateTime        @default(now())
  deletedAt       DateTime?
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id])
  variant         ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productSku])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  webhookEventId    String?       @unique
  amount            Int
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  rawPayload        Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  refundedAt        DateTime?
  paymentMethod     String        @default("RAZORPAY")
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([refundedAt])
  @@index([createdAt])
  @@index([orderId, status])
}

model InventoryMovement {
  id        String                @id @default(cuid())
  variantId String
  quantity  Int
  type      InventoryMovementType
  reason    String
  orderId   String?
  createdAt DateTime              @default(now())
  order     Order?                @relation(fields: [orderId], references: [id])
  variant   ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([orderId])
  @@index([type])
  @@index([createdAt])
  @@index([variantId, createdAt])
}

model WebhookEvent {
  id                String           @id @default(cuid())
  eventId           String           @unique
  eventType         String
  razorpayPaymentId String?
  razorpayOrderId   String?
  payload           Json
  createdAt         DateTime         @default(now())
  status            WebhookLogStatus

  @@index([eventType])
  @@index([razorpayPaymentId])
  @@index([razorpayOrderId])
  @@index([status])
  @@index([createdAt])
}

model Review {
  id        String    @id @default(cuid())
  userId    String
  productId String
  rating    Int
  comment   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model NewsletterSubscriber {
  id        String    @id @default(cuid())
  email     String    @unique
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([deletedAt])
  @@index([createdAt])
}

enum ProductCollection {
  SHOES
  JEWELLERY
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CheckoutSessionStatus {
  PENDING
  COMPLETED
  EXPIRED
  FAILED
}

enum CheckoutSessionMode {
  CART
  BUY_NOW
}

enum InventoryMovementType {
  SALE
  RESTOCK
  ADMIN_ADJUSTMENT
  REFUND
}

enum WebhookLogStatus {
  INVALID_SIGNATURE
  DUPLICATE_EVENT
  PAYMENT_AMOUNT_MISMATCH
  OUT_OF_STOCK
  FULFILLED
  PAYMENT_FAILED
  IGNORED
}
