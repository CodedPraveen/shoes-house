# Copy this file to .env.local for local development and replace placeholders.
# See docs/bullmq.md for the Vercel/Render environment split.

NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL="postgresql://user:password@localhost:5432/postmart"
DIRECT_URL="postgresql://user:password@localhost:5432/postmart"
REDIS_URL="redis://localhost:6379"

BULLMQ_WORKER_CONCURRENCY=3
BULLMQ_WORKER_RATE_MAX=20
BULLMQ_WORKER_RATE_DURATION_MS=10000
BULLMQ_REDIS_CONNECT_TIMEOUT_MS=3000

IMAGE_STORAGE_ROOT=.data/images

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SECRET=whsec_replace_me
ADMIN_EMAILS=you@example.com
