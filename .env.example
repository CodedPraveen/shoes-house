# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAILS=you@example.com

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/profile
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/profile

# PostgreSQL / Prisma
DATABASE_URL="postgresql://user:password@pooler.example.com:6543/database?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://user:password@database.example.com:5432/database"

# Redis / BullMQ
REDIS_URL="rediss://default:password@redis.example.com:6379"
BULLMQ_WORKER_CONCURRENCY=3
BULLMQ_WORKER_RATE_MAX=20
BULLMQ_WORKER_RATE_DURATION_MS=10000
BULLMQ_REDIS_CONNECT_TIMEOUT_MS=3000

# Persistent image storage
IMAGE_STORAGE_ROOT=/data/ecommerce/images

# Payments and shipping
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
AFTERSHIP_API_KEY=replace_me
AFTERSHIP_WEBHOOK_SECRET=replace_me

# Google Maps Platform
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=replace_me
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=replace_me
GOOGLE_GEOCODING_API_KEY=replace_me
GOOGLE_GEOLOCATION_API_KEY=replace_me
