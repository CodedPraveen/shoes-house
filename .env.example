
# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Meta Pixel 
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Server-only. Phone OTP remains disabled until the account-specific 2Factor
# send/verify contract is validated and TwoFactorProvider is implemented.
TWO_FACTOR_API_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/profile
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/profile


ADMIN_EMAILS=
ADMIN_URL=/new-admin

# Supabase PostgreSQL (Prisma)

#ORM 
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL=


# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


# Aftership (shipping API)
AFTERSHIP_API_KEY=
AFTERSHIP_WEBHOOK_SECRET=

# Redis
REDIS_URL=redis://redis:6379 # Change this to your Redis URL
REDIS_PORT=6379
REDIS_PASSWORD=
BULLMQ_WORKER_CONCURRENCY=3
BULLMQ_WORKER_RATE_MAX=20
BULLMQ_WORKER_RATE_DURATION_MS=10000
BULLMQ_REDIS_CONNECT_TIMEOUT_MS=3000

# Google Maps Platform
# Browser-exposed key: restrict by HTTP referrer and to Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional production map ID. The picker uses Google's DEMO_MAP_ID when omitted.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Server-only key: restrict to Geocoding API and your deployment's source IPs when possible.
GOOGLE_GEOCODING_API_KEY=
# Optional server-only key. Used only when real Wi-Fi/cell measurements are available.
GOOGLE_GEOLOCATION_API_KEY=your_server_geolocation_key # optional server-only key. Used only when real Wi-Fi/cell measurements are available.
